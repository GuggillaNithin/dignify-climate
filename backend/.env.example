# Dygnify Backend Environment Variables Template
PROJECT_NAME="Dygnify"
PROJECT_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Allowed Frontend Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# MongoDB Atlas or Local instance
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE="terrascope"

# Open-Meteo Historical Weather Archive URL
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"
PROVIDER_TIMEOUT_SECONDS=15.0
PROVIDER_MAX_RETRIES=3

# Optional Groq API Key (AI briefing summaries only)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
GROQ_TIMEOUT_SECONDS=12.0
AI_PROMPT_VERSION="v1.0-cautious"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
